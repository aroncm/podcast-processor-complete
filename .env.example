# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CANDIDATE_MODEL=gpt-5.6-terra
OPENAI_CANDIDATE_REASONING=low
OPENAI_EDITORIAL_MODEL=gpt-5.6-sol
OPENAI_EDITORIAL_REASONING=high
MIN_EDITORIAL_QUALITY=0.78
MIN_CONTEXT_CONFIDENCE=0.72

# Web API Configuration
# Authorization uses Supabase app_metadata.role=admin; never use user_metadata.
ALLOWED_ORIGINS=https://podtakes.com,https://www.podtakes.com,http://localhost:5173
SCHEDULED_MAX_EPISODES=2
MAX_EPISODES_PER_RUN=3

# Modal Webhook URLs (get these from modal app list)
MODAL_PROCESS_URL=your_modal_process_url_here
MODAL_CLIP_URL=your_modal_clip_url_here
